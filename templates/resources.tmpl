def _text(value: str | int | float | bool | Sequence[str | int | float | bool]) -> str:
    """Spell a parameter as the ``simple`` style of OpenAPI does."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str | int | float):
        return str(value)
    return ",".join(_text(item) for item in value)
