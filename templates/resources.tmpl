{{- $ops := .Operations -}}
{{- /* One file per tag: a "plumbing" client class exposing every operation for
       that resource, returning the raw response envelope. */ -}}
{{- range $tag := uniqueTags $ops }}
--- {{ snakecase $tag }}_gen.py
# Code generated by openapi-gen; DO NOT EDIT.

from __future__ import annotations

from collections.abc import AsyncIterator, Mapping
from typing import Any
{{- /* Path parameters are percent-encoded on the way out, so only the clients
       that have any need the import. */ -}}
{{- $quoted := false }}
{{- range $op := $ops }}
{{- if and (eq (first $op.Operation.Tags) $tag) (pathParameters $op) }}{{ $quoted = true }}{{ end }}
{{- end }}
{{- if $quoted }}
from urllib.parse import quote
{{- end }}
{{- /* Likewise the marker for lists sent as one comma-separated parameter. */ -}}
{{- $csv := false }}
{{- range $op := $ops }}
{{- if eq (first $op.Operation.Tags) $tag }}
{{- range queryParameters $op }}
{{- if and (.Schema.Value.Type.Is "array") (not (.SerializationMethod).Explode) }}{{ $csv = true }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

from ...core.http import UNSET, ApiClient, TimeoutOption{{ if $csv }}, comma_separated{{ end }}
from . import models_gen as models


class {{ pascalcase $tag }}Api(ApiClient):
    """Low-level "plumbing" client for the `{{ $tag }}` resource.

    Methods mirror the OpenAPI specification and return the raw response
    envelope. The idiomatic clients are built on top of this.
    """
{{- range $op := $ops }}
{{- if eq (first $op.Operation.Tags) $tag }}
{{ template "method" $op }}
{{- end }}
{{- end }}
{{ end }}
{{- define "method" -}}
{{- $op := .Operation -}}
{{- $path := .Path -}}
{{- /* A path parameter is one segment, whatever it contains: a name with a
       `/`, `?` or `#` in it must not change the path or start a query, so each
       is percent-encoded with nothing left unescaped. */ -}}
{{- range pathParameters . }}{{ $path = replace (printf "{%s}" .Name) (printf "{quote(%s, safe='')}" (pySafeName .Name)) $path }}{{ end -}}
{{- $ret := qualifyModels "models" (pyTypeRef (responseJSONSchema $op)) -}}
{{- /* An operation whose response is a server-sent event stream has no JSON
       response body, so it would otherwise be typed as returning nothing.
       Yield the event payload instead, streamed via ApiClient._stream(). */ -}}
{{- $sse := false -}}
{{- range $entry := sortedResponseCodes $op.Responses -}}
{{- if and (not $sse) (or (hasPrefix "2" $entry.Code) (eq $entry.Code "default")) -}}
{{- with $entry.Ref -}}{{- with .Value -}}
{{- with index .Content "text/event-stream" -}}{{- $sse = .Schema -}}{{- end -}}
{{- end -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if and $sse (eq $ret "") -}}
{{- $ret = qualifyModels "models" (pyTypeRef $sse) -}}
{{- else -}}
{{- $sse = false -}}
{{- end -}}
{{- $bodyRef := requestJSONSchema $op -}}
{{- $bodyReq := requestBodyRequired $op -}}
{{- $query := queryParameters . -}}
{{- /* The specification models the filters of most GET and HEAD operations
       as a body *and* as repeatable query parameters (`?uuid=&name=&...`), and
       a body on a GET is unusual enough to avoid where it can be. An
       identifier travels fine in the query, so a body that carries nothing
       else is dropped. A body with more than that -- `wait` taking a state and
       a timeout, `log` an offset and a limit -- is kept: for some operations it
       is the only form the API reads those from. */ -}}
{{- $ids := list "uuid" "name" -}}
{{- if and $bodyRef (or (eq .Method "GET") (eq .Method "HEAD")) -}}
{{- $schema := $bodyRef.Value -}}
{{- if and $schema $schema.Items -}}{{- $schema = $schema.Items.Value -}}{{- end -}}
{{- /* An item spells its identifier as a `oneOf` and its other fields beside
       it, so the whole composition is walked rather than the top level. */ -}}
{{- $props := list -}}
{{- if $schema -}}
{{- range $prop, $ps := $schema.Properties -}}{{- $props = append $props $prop -}}{{- end -}}
{{- range $part := concat $schema.AllOf $schema.OneOf -}}
{{- with $part.Value -}}
{{- range $prop, $ps := .Properties -}}{{- $props = append $props $prop -}}{{- end -}}
{{- range $branch := concat .AllOf .OneOf -}}
{{- with $branch.Value -}}
{{- range $prop, $ps := .Properties -}}{{- $props = append $props $prop -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $names := list -}}
{{- range $q := $query -}}{{- $names = append $names $q.Name -}}{{- end -}}
{{- $beyondIds := false -}}
{{- $idsInQuery := true -}}
{{- range $prop := $props -}}
{{- if has $prop $ids -}}
{{- if not (has $prop $names) -}}{{- $idsInQuery = false -}}{{- end -}}
{{- else -}}
{{- $beyondIds = true -}}
{{- end -}}
{{- end -}}
{{- if and (not $beyondIds) $idsInQuery -}}
{{- $bodyRef = false -}}
{{- $bodyReq = false -}}
{{- end -}}
{{- end }}
    {{ if $sse }}def{{ else }}async def{{ end }} {{ pySafeName (snakecase $op.OperationID) }}(
        self,
        {{- range pathParameters . }}
        {{ pySafeName .Name }}: {{ qualifyModels "models" (paramToPyType .) }},
        {{- end }}
        *,
        {{- range $query }}
        {{ pySafeName .Name }}: {{ qualifyModels "models" (paramToPyType .) }} | None = None,
        {{- end }}
        {{- if $bodyRef }}
        body: {{ qualifyModels "models" (pyTypeRef $bodyRef) }}{{ if not $bodyReq }} | None = None{{ end }},
        {{- end }}
        headers: Mapping[str, str] | None = None,
        base_url: str | None = None,
        timeout: TimeoutOption = UNSET,
    ) -> {{ if $sse }}AsyncIterator[{{ $ret }}]{{ else if eq $ret "" }}None{{ else }}{{ $ret }}{{ end }}:
{{- with $op.Summary }}
        {{ pyDoc . "        " }}
{{- else }}
{{- with $op.Description }}
        {{ pyDoc . "        " }}
{{- end }}
{{- end }}
        return {{ if not $sse }}await {{ end }}self.{{ if $sse }}_stream{{ else if eq $ret "" }}_request_no_content{{ else }}_request{{ end }}(
            {{ if or $sse (ne $ret "") }}{{ $ret }},
            {{ end }}method="{{ .Method }}",
            {{ if pathParameters . }}path=f"{{ $path }}"{{ else }}path="{{ $path }}"{{ end }},
            {{- if $query }}
            query={
                {{- range $query }}
                {{- /* A list the specification does not explode travels as one
                   comma-separated value (`?tags=a,b`), not as a repeated one. */ -}}
                {{- if and (.Schema.Value.Type.Is "array") (not (.SerializationMethod).Explode) }}
                "{{ .Name }}": comma_separated({{ pySafeName .Name }}),
                {{- else }}
                "{{ .Name }}": {{ pySafeName .Name }},
                {{- end }}
                {{- end }}
            },
            {{- end }}
            {{- if $bodyRef }}
            body=body,
            {{- end }}
            headers=headers,
            base_url=base_url,
            timeout=timeout,
        )
{{ end -}}
