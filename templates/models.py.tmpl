{{- /* Models for one API surface: enum aliases, the pydantic models, then the
  other aliases.

  Python evaluates a module top to bottom, where TypeScript's declarations are
  order-free, so this is laid out to survive the parser's alphabetical order:
  self-contained enum aliases first, then the models with deferred annotations,
  then the aliases for the schemas that are no model -- an assignment is
  evaluated on the spot, unlike an annotation, so what it names must already
  exist -- and a rebuild pass once every name does. */ -}}
--- models_gen.py
# Code generated by openapi-gen; DO NOT EDIT.
#
# Type definitions for the Unikraft Cloud API, generated from the OpenAPI
# specification. These mirror the wire format exactly.

from __future__ import annotations

from datetime import datetime
from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, Field

# Enumerations, as Literal aliases rather than enum classes: the values stay
# plain strings, so `state == "running"` needs no import, and a value the server
# adds is one line to widen.
{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- if $schema.Enum }}

{{ $m.SchemaName }} = {{ enumPyLiteral $schema }}
{{- with $schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- end }}
{{- end }}

{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $name := $m.SchemaName }}
{{- /* A request body is the caller's to fill in, so a field the specification
  requires is required here too. A response is the server's, and one shape
  serves several answers, so there every field stays optional. The TypeSpec
  convention names request schemas `<Verb><Resource>Request*`. */ -}}
{{- $request := and (contains "Request" $name) (not (contains "Response" $name)) }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- if and (not $schema.Enum) (not $union) (not $scalar) }}


class {{ $name }}(BaseModel):
{{- with $schema.Description }}
    {{ pyDoc . "    " }}
{{ end }}
    # Fields the specification does not describe are kept rather than dropped,
    # so a newly added one survives a round trip and does not break this client.
{{- if $request }}
    # A field the specification requires is required here too, so a request
    # missing one fails at construction rather than at the server.
{{- else }}
    # Every field is optional: one response shape serves several requests, and a
    # summary listing or a failed bulk item carries only some of them.
{{- end }}
    model_config = ConfigDict(extra="allow", populate_by_name=True)
{{ range $prop := propertyNamesOrdered $name $schema }}
{{- $p := getProperty $schema $prop }}
{{- $safe := pySafeName $prop }}
{{- /* A date-time is an ISO-8601 string on the wire; pydantic parses it into a
  `datetime` and writes it back out in the same form. */ -}}
{{- $type := schemaToPyType $p }}
{{- if eq $p.Format "date-time" }}{{ $type = "datetime" }}{{ end }}
{{- if and $request (getPropertyRequired $schema $prop) }}
{{- if eq $safe $prop }}
    {{ $safe }}: {{ $type }}
{{- else }}
    {{ $safe }}: {{ $type }} = Field(alias="{{ $prop }}")
{{- end }}
{{- else if eq $safe $prop }}
    {{ $safe }}: {{ $type }} | None = None
{{- else }}
    {{ $safe }}: {{ $type }} | None = Field(default=None, alias="{{ $prop }}")
{{- end }}
{{- with $p.Description }}
    {{ pyDoc . "    " }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- /* A schema that is only a union of branches, or a plain scalar or array,
  is an alias, not a model: `Line = Shell | Args`, `Args = list[str]`. It comes
  after the models because the assignment evaluates the names it uses right
  here, where a field annotation would wait for the rebuild below. */ -}}
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- if and (not $schema.Enum) (or $union $scalar) }}

{{ $m.SchemaName }} = {{ schemaToPyType $schema }}
{{- with $schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- end }}
{{- end }}


# Annotations are deferred, so a model may name one defined further down. This
# resolves them all now: a reference that cannot be resolved becomes an error on
# import rather than a surprise at the first request.
for _model in (
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- if and (not $schema.Enum) (not $union) (not $scalar) }}
    {{ $m.SchemaName }},
{{- end }}
{{- end }}
):
    _model.model_rebuild()
