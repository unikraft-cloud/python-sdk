{{- /* Models for one API surface: enum aliases, the pydantic models, then the
  other aliases.

  Python evaluates a module top to bottom, where TypeScript's declarations are
  order-free, so this is laid out to survive the parser's alphabetical order:
  self-contained enum aliases first, then the models with deferred annotations,
  then the aliases for the schemas that are no model -- an assignment is
  evaluated on the spot, unlike an annotation, so what it names must already
  exist -- and a rebuild pass once every name does. */ -}}
--- models_gen.py
# Code generated by openapi-gen; DO NOT EDIT.
#
# Type definitions for the Unikraft Cloud API, generated from the OpenAPI
# specification. These mirror the wire format exactly.

from __future__ import annotations

from datetime import datetime
from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, Field

# Enumerations, as Literal aliases rather than enum classes: the values stay
# plain strings, so `state == "running"` needs no import, and a value the server
# adds is one line to widen.
{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- if $schema.Enum }}

{{ $m.SchemaName }} = {{ enumPyLiteral $schema }}
{{- with $schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- end }}
{{- end }}

{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $name := $m.SchemaName }}
{{- /* A request body is the caller's to fill in, so a field the specification
  requires is required here too. A response is the server's, and one shape
  serves several answers, so there every field stays optional. The TypeSpec
  convention names request schemas `<Verb><Resource>Request*`. */ -}}
{{- $request := and (contains "Request" $name) (not (contains "Response" $name)) }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- /* A map is an object with no properties of its own and a schema, or a
  `true`, for the additional ones. Has is a *bool, read through toJson. */ -}}
{{- $map := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) (or (not $schema.Type) ($schema.Type.Is "object")) (or $schema.AdditionalProperties.Schema (eq (toJson $schema.AdditionalProperties.Has) "true")) }}
{{- if and (not $schema.Enum) (not $union) (not $scalar) (not $map) }}


class {{ $name }}(BaseModel):
{{- with $schema.Description }}
    {{ pyDoc . "    " }}
{{ end }}
    # Fields the specification does not describe are kept rather than dropped,
    # so a newly added one survives a round trip and does not break this client.
{{- if $request }}
    # A field the specification requires is required here too, so a request
    # missing one fails at construction rather than at the server.
{{- else }}
    # Every field is optional: one response shape serves several requests, and a
    # summary listing or a failed bulk item carries only some of them.
{{- end }}
    model_config = ConfigDict(extra="allow", populate_by_name=True)
{{- $fields := list }}
{{ range $prop := propertyNamesOrdered $name $schema }}
{{- $p := getProperty $schema $prop }}
{{- /* A field is an attribute, so a name that is no identifier is spelled in
  snake case and kept as the alias; one that still is none is refused. */ -}}
{{- $safe := pySafeName $prop }}
{{- if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $safe) }}{{ $safe = pySafeName (snakecase $prop) }}{{ end }}
{{- if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $safe) }}
{{- fail (printf "property %q of %s cannot name a Python field, even in snake case; rename it in the specification" $prop $name) }}
{{- end }}
{{- if has $safe $fields }}
{{- fail (printf "property %q of %s renders the field %s, which another property renders too; rename one of them in the specification" $prop $name $safe) }}
{{- end }}
{{- $fields = append $fields $safe }}
{{- /* A date-time is an ISO-8601 string on the wire; pydantic parses it into a
  `datetime` and writes it back out in the same form. */ -}}
{{- $type := schemaToPyType $p }}
{{- if eq $p.Format "date-time" }}{{ $type = "datetime" }}{{ end }}
{{- if and $request (getPropertyRequired $schema $prop) }}
{{- if eq $safe $prop }}
    {{ $safe }}: {{ $type }}
{{- else }}
    {{ $safe }}: {{ $type }} = Field(alias={{ printf "%q" $prop }})
{{- end }}
{{- else if eq $safe $prop }}
    {{ $safe }}: {{ $type }} | None = None
{{- else }}
    {{ $safe }}: {{ $type }} | None = Field(default=None, alias={{ printf "%q" $prop }})
{{- end }}
{{- with $p.Description }}
    {{ pyDoc . "    " }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- /* A schema that is only a union of branches, or a plain scalar, array or map,
  is an alias, not a model: `Line = Shell | Args`, `Args = list[str]`,
  `Env = dict[str, str]`. It comes after the models because the assignment
  evaluates the names it uses right here, where a field annotation would wait
  for the rebuild below. An alias that names another alias comes after it, so
  the aliases go out in passes, each taking those whose aliases are all out;
  one left at the end names itself. */ -}}
{{- $aliases := list }}
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- /* A map is an object with no properties of its own and a schema, or a
  `true`, for the additional ones. Has is a *bool, read through toJson. */ -}}
{{- $map := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) (or (not $schema.Type) ($schema.Type.Is "object")) (or $schema.AdditionalProperties.Schema (eq (toJson $schema.AdditionalProperties.Has) "true")) }}
{{- if and (not $schema.Enum) (or $union $scalar $map) }}{{ $aliases = append $aliases $m.SchemaName }}{{ end }}
{{- end }}
{{- $emitted := list }}
{{- range $pass := $aliases }}
{{- range $m := $.Models }}
{{- $name := $m.SchemaName }}
{{- if and (has $name $aliases) (not (has $name $emitted)) }}
{{- $code := schemaToPyType $m.Schema }}
{{- $ready := true }}
{{- range $other := $aliases }}
{{- if and (not (has $other $emitted)) (regexMatch (printf "\\b%s\\b" $other) $code) }}{{ $ready = false }}{{ end }}
{{- end }}
{{- if $ready }}

{{ $name }} = {{ $code }}
{{- with $m.Schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- $emitted = append $emitted $name }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- range $name := $aliases }}
{{- if not (has $name $emitted) }}
{{- fail (printf "schema %s is an alias that names itself, directly or through another alias, so it cannot be rendered" $name) }}
{{- end }}
{{- end }}


# Annotations are deferred, so a model may name one defined further down. This
# resolves them all now: a reference that cannot be resolved becomes an error on
# import rather than a surprise at the first request.
for _model in (
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- /* A map is an object with no properties of its own and a schema, or a
  `true`, for the additional ones. Has is a *bool, read through toJson. */ -}}
{{- $map := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) (or (not $schema.Type) ($schema.Type.Is "object")) (or $schema.AdditionalProperties.Schema (eq (toJson $schema.AdditionalProperties.Has) "true")) }}
{{- if and (not $schema.Enum) (not $union) (not $scalar) (not $map) }}
    {{ $m.SchemaName }},
{{- end }}
{{- end }}
):
    _model.model_rebuild()
