{{- /* Models for one API surface: enum aliases, then the pydantic models.

  Python evaluates a module top to bottom, where TypeScript's declarations are
  order-free, so this is laid out to survive the parser's alphabetical order:
  self-contained enum aliases first, then the models with deferred annotations,
  then a rebuild pass once every name exists. */ -}}
--- models_gen.py
# Code generated by openapi-gen; DO NOT EDIT.
#
# Type definitions for the Unikraft Cloud API, generated from the OpenAPI
# specification. These mirror the wire format exactly.

from __future__ import annotations

from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, Field

# Enumerations, as Literal aliases rather than enum classes: the values stay
# plain strings, so `state == "running"` needs no import, and a value the server
# adds is one line to widen.
{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- if $schema.Enum }}

{{ $m.SchemaName }} = {{ enumPyLiteral $schema }}
{{- with $schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- end }}
{{- end }}

{{ range $m := .Models }}
{{- $schema := $m.Schema }}
{{- $name := $m.SchemaName }}
{{- if not $schema.Enum }}
{{- if and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- /* A schema that is only a union of branches is an alias, not a model. */}}

{{ $name }} = {{ schemaToPyType $schema }}
{{- with $schema.Description }}
{{ pyDoc . "" }}
{{- end }}
{{- else }}


class {{ $name }}(BaseModel):
{{- with $schema.Description }}
    {{ pyDoc . "    " }}
{{ end }}
    # Fields the specification does not describe are kept rather than dropped,
    # so a newly added one survives a round trip and does not break this client.
    model_config = ConfigDict(extra="allow", populate_by_name=True)
{{ range $prop := propertyNamesOrdered $name $schema }}
{{- $p := getProperty $schema $prop }}
{{- $required := getPropertyRequired $schema $prop }}
{{- $safe := pySafeName $prop }}
{{- $type := schemaToPyType $p }}
{{- if $required }}
{{- if eq $safe $prop }}
    {{ $safe }}: {{ $type }}
{{- else }}
    {{ $safe }}: {{ $type }} = Field(alias="{{ $prop }}")
{{- end }}
{{- else }}
{{- if eq $safe $prop }}
    {{ $safe }}: {{ $type }} | None = None
{{- else }}
    {{ $safe }}: {{ $type }} | None = Field(default=None, alias="{{ $prop }}")
{{- end }}
{{- end }}
{{- with $p.Description }}
    {{ pyDoc . "    " }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}


# Annotations are deferred, so a model may name one defined further down. This
# resolves them all now: a reference that cannot be resolved becomes an error on
# import rather than a surprise at the first request.
for _model in (
{{- range $m := .Models }}
{{- $schema := $m.Schema }}
{{- if and (not $schema.Enum) (not (and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties))) }}
    {{ $m.SchemaName }},
{{- end }}
{{- end }}
):
    _model.model_rebuild()
